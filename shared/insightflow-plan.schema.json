{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insightflow.local/schemas/insightflow-plan.schema.json",
  "title": "InsightFlowOperationPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "intent",
    "semantic_targets",
    "operations",
    "output",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_class", "summary"],
      "properties": {
        "task_class": {
          "type": "string",
          "enum": [
            "filter",
            "transform",
            "analyze",
            "pivot",
            "chart",
            "export",
            "multi_step",
            "unknown"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "semantic_targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemanticTarget"
      },
      "default": []
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Operation"
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sheet_name_seed", "open_automatically", "artifact_kind"],
      "properties": {
        "sheet_name_seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "open_automatically": {
          "type": "boolean",
          "const": true
        },
        "artifact_kind": {
          "type": "string",
          "enum": [
            "worksheet",
            "pivot_table",
            "chart",
            "report",
            "worksheet_and_chart"
          ]
        }
      }
    },
    "needs_user_confirmation": {
      "type": "boolean",
      "default": false
    },
    "clarifying_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "default": []
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "default": []
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "$defs": {
    "SemanticTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "kind", "hint"],
      "properties": {
        "target_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_\\-]{0,31}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "entity",
            "flag",
            "metric",
            "category",
            "date",
            "currency",
            "text",
            "group",
            "output_label"
          ]
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "expected_type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "date", "currency", "any"],
          "default": "any"
        },
        "cardinality": {
          "type": "string",
          "enum": ["single", "many", "any"],
          "default": "any"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "nullable": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "Operation": {
      "oneOf": [
        { "$ref": "#/$defs/FilterRowsOp" },
        { "$ref": "#/$defs/SortRowsOp" },
        { "$ref": "#/$defs/CategorizeColumnsOp" },
        { "$ref": "#/$defs/NormalizeColumnsOp" },
        { "$ref": "#/$defs/ConvertCurrencyOp" },
        { "$ref": "#/$defs/PivotTableOp" },
        { "$ref": "#/$defs/ChartOp" },
        { "$ref": "#/$defs/RenameSheetOp" },
        { "$ref": "#/$defs/GroupedAggregationOp" },
        { "$ref": "#/$defs/SummaryStatisticsOp" },
        { "$ref": "#/$defs/MissingValueAnalysisOp" },
        { "$ref": "#/$defs/DuplicateDetectionOp" },
        { "$ref": "#/$defs/OutlierDetectionOp" }
      ]
    },
    "FilterRowsOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "where"],
      "properties": {
        "type": { "const": "filter_rows" },
        "where": { "$ref": "#/$defs/ConditionGroup" }
      }
    },
    "ConditionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logic", "conditions"],
      "properties": {
        "logic": {
          "type": "string",
          "enum": ["AND", "OR"]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/Condition" },
              { "$ref": "#/$defs/ConditionGroup" }
            ]
          }
        }
      }
    },
    "Condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "operator", "value"],
      "properties": {
        "target_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "operator": {
          "type": "string",
          "enum": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "contains",
            "not_contains",
            "in",
            "not_in",
            "between",
            "is_null",
            "not_null"
          ]
        },
        "value": {},
        "value_type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "date", "currency", "list", "any"],
          "default": "any"
        },
        "case_sensitive": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "SortRowsOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "keys"],
      "properties": {
        "type": { "const": "sort_rows" },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_ref", "direction"],
            "properties": {
              "target_ref": { "type": "string", "minLength": 1, "maxLength": 64 },
              "direction": { "type": "string", "enum": ["asc", "desc"] }
            }
          }
        }
      }
    },
    "CategorizeColumnsOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scope"],
      "properties": {
        "type": { "const": "categorize_columns" },
        "scope": {
          "type": "string",
          "enum": ["all", "matched", "selected"]
        },
        "strategy": {
          "type": "string",
          "enum": ["header_based", "type_based", "hybrid"],
          "default": "hybrid"
        }
      }
    },
    "NormalizeColumnsOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scope"],
      "properties": {
        "type": { "const": "normalize_columns" },
        "scope": {
          "type": "string",
          "enum": ["all", "matched", "selected"]
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "trim_whitespace",
              "standardize_case",
              "parse_dates",
              "parse_numbers",
              "split_text",
              "deduplicate_labels",
              "fill_blanks",
              "remove_currency_symbols"
            ]
          },
          "default": []
        }
      }
    },
    "ConvertCurrencyOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_currency", "exchange_rate_source", "rate_timestamp"],
      "properties": {
        "type": { "const": "convert_currency" },
        "target_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "scope": {
          "type": "string",
          "enum": ["all", "matched", "selected"],
          "default": "matched"
        },
        "exchange_rate_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "rate_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "rounding_mode": {
          "type": "string",
          "enum": ["round", "floor", "ceil", "bankers"],
          "default": "round"
        }
      }
    },
    "PivotTableOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rows", "values"],
      "properties": {
        "type": { "const": "create_pivot" },
        "rows": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "columns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "default": []
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_ref", "aggregation"],
            "properties": {
              "target_ref": { "type": "string", "minLength": 1, "maxLength": 64 },
              "aggregation": {
                "type": "string",
                "enum": ["sum", "count", "average", "min", "max", "median", "distinct_count"]
              }
            }
          }
        }
      }
    },
    "ChartOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "chart_type", "x"],
      "properties": {
        "type": { "const": "build_chart" },
        "chart_type": {
          "type": "string",
          "enum": ["bar", "line", "scatter", "pie", "area", "histogram", "box"]
        },
        "x": { "type": "string", "minLength": 1, "maxLength": 64 },
        "y": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "default": []
        },
        "series": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "RenameSheetOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name_seed"],
      "properties": {
        "type": { "const": "rename_sheet" },
        "name_seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      }
    },
    "GroupedAggregationOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "group_by", "metrics"],
      "properties": {
        "type": { "const": "grouped_aggregation" },
        "group_by": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "default": []
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_ref", "aggregation"],
            "properties": {
              "target_ref": { "type": "string", "minLength": 1, "maxLength": 64 },
              "aggregation": {
                "type": "string",
                "enum": ["sum", "count", "average", "min", "max", "median", "distinct_count"]
              },
              "alias": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          }
        },
        "include_totals": { "type": "boolean", "default": false }
      }
    },
    "SummaryStatisticsOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "columns", "statistics"],
      "properties": {
        "type": { "const": "summary_statistics" },
        "columns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "default": []
        },
        "statistics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["count", "missing_count", "mean", "median", "std_dev", "min", "max", "variance", "q1", "q3", "iqr"]
          }
        }
      }
    },
    "MissingValueAnalysisOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "columns"],
      "properties": {
        "type": { "const": "missing_value_analysis" },
        "columns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "default": []
        },
        "include_percentages": { "type": "boolean", "default": true }
      }
    },
    "DuplicateDetectionOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "keys"],
      "properties": {
        "type": { "const": "duplicate_detection" },
        "keys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "default": []
        },
        "include_counts": { "type": "boolean", "default": true },
        "case_sensitive": { "type": "boolean", "default": false }
      }
    },
    "OutlierDetectionOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "columns", "method", "threshold"],
      "properties": {
        "type": { "const": "outlier_detection" },
        "columns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "default": []
        },
        "method": {
          "type": "string",
          "enum": ["iqr", "zscore"]
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
