DATA_ANALYSIS_LLM_STATE_DIR=runtime/state
INSIGHT_LEARNING_DB_PATH=runtime/learning.db
INSIGHT_LEARNING_RUNTIME_DIR=runtime
INSIGHT_LEARNING_ALLOW_REMOTE_REASONING=false
INSIGHT_LEARNING_APP_NAME=insight-learning

# Optional Kaggle-trained adapters. Leave disabled until the downloaded adapter
# directories exist on the machine running Insight Learning.
TRAINER_FINANCE_ADAPTER_ENABLED=false
FINANCE_ADAPTER_PATH=C:/models/finance_candidate_v2
FINANCE_ADAPTER_VERSION=finance_candidate_v2
TRAINER_RETAIL_ADAPTER_ENABLED=false
LEARNER_ADAPTERS_ENABLED=true
LEARNER_ADAPTER_ROOT=models/adapters
LEARNER_ROUTER_MIN_CONFIDENCE=0.72
LEARNER_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LEARNER_BASE_MODEL_LOCAL_ONLY=false
MYNTRA_ADAPTER_VERSION=myntra_candidate_v1
RESTAURANT_ADAPTER_VERSION=restaurant_plan_adapter_v2
# Optional trained local semantic adapter. Keep off until validation passes.
LOCAL_SEMANTIC_MODE=off
LOCAL_SEMANTIC_MODEL_PATH=runtime/models/semantic_extractor

